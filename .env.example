APP_NAME=LinkerLee
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=linkerlee
DB_USERNAME=postgres
DB_PASSWORD=
# Must match APP_TIMEZONE (UTC). Sets the Postgres session timezone so
# timestampTz columns are written and read back in UTC everywhere.
# DB_TIMEZONE=UTC

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=mailgun
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional. Only needed for save-by-email: users forward a link to their private
# inbox-<token>@${MAILGUN_INBOUND_DOMAIN} address and it becomes a bookmark.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_INBOUND_DOMAIN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated emails allowed to reach /log-viewer. Leave empty to allow nobody.
LOG_VIEWER_ALLOWED_EMAILS=

# Content extraction (config/scraping.php). SCRAPING_FALLBACKS is a comma-separated
# list of driver keys tried, in order, when the default driver fails.
SCRAPING_DRIVER=http_readability
SCRAPING_FALLBACKS=browsershot
SCRAPING_TIMEOUT=15
SCRAPING_MAX_BYTES=5242880
SCRAPING_USER_AGENT="LinkerLeeBot/1.0 (+https://linkerlee.com)"
SCRAPING_MIN_WORD_COUNT=50
SCRAPING_KEEP_SNAPSHOTS=5

# Optional. Only needed for the "jina" extraction driver.
JINA_API_KEY=

# Optional. Only needed for the "browsershot" extraction driver, which needs a
# local Chrome/Chromium and Node.js to render JavaScript-heavy pages.
BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_NODE_BINARY=
