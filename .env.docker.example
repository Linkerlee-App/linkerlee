# Environment for a Docker deployment of LinkerLee.
#
#   cp .env.docker.example .env
#   docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show
#   # paste the value into APP_KEY below, then:
#   docker compose up -d --build
#
# docker-compose.yml reads this same file, so the DB_* values below configure
# both the MySQL container and the application that connects to it.

APP_NAME=LinkerLee
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# The URL people will actually visit. Behind a reverse proxy terminating TLS,
# use the public https:// address.
APP_URL=http://localhost:8000

# Host port the web container publishes. Put a reverse proxy in front of it
# for TLS; nothing here terminates HTTPS.
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Written to storage/logs (readable at /log-viewer) and to the container log,
# where `docker compose logs app` picks it up.
LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# `mysql` is the compose service name. Change every password before deploying.
# The compose stack is built around MySQL; SQLite would keep its file inside the
# container and be lost the next time the container is replaced.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=linkerlee
DB_USERNAME=linkerlee
DB_PASSWORD=please-change-me
# Used by the MySQL container only.
DB_ROOT_PASSWORD=please-change-me-too

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# `log` writes mail to the log instead of sending it, which is enough to grab
# the email-verification link on a private instance. For a real deployment set
# MAIL_MAILER=smtp and the SMTP credentials, or use mailgun.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional. Only needed for save-by-email: users forward a link to their private
# inbox-<token>@${MAILGUN_INBOUND_DOMAIN} address and it becomes a bookmark.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_INBOUND_DOMAIN=

# Comma-separated emails allowed to reach /log-viewer. Leave empty to allow nobody.
LOG_VIEWER_ALLOWED_EMAILS=
